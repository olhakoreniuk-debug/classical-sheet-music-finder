{
  "name": "classical-sheet-music-finder",
  "version": "0.1.0",
  "description": "Imports classical sheet music metadata from the IMSLP API into PostgreSQL.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:db": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/db/*.test.js\"",
    "fetch:sample": "node --env-file-if-exists=.env scripts/fetch-sample.js",
    "import": "node --env-file-if-exists=.env scripts/import.js",
    "verify:import": "node --env-file-if-exists=.env scripts/verify-import.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "api": "node --env-file-if-exists=.env scripts/serve-api.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "pg": "^8.23.1",
    "yaml": "2.9.1"
  }
}
