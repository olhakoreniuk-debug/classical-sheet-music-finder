%%{init: {"theme": "base", "htmlLabels": false, "flowchart": {"htmlLabels": false, "curve": "basis", "nodeSpacing": 50, "rankSpacing": 70}, "themeVariables": {"fontFamily": "Arial", "fontSize": "15px", "lineColor": "#5b6577", "primaryTextColor": "#1f2933"}}}%%
%% FINAL: the dependency rule (Dependency Inversion). Arrows point from "imports" to "is imported".
%% Every source-code dependency points TOWARDS src/core/. The core imports nothing outside itself.
%% Red arrows are forbidden; test/architecture.test.js fails if one appears.

flowchart LR
    scripts["scripts/<br/>composition root:<br/>creates and wires everything"]
    cli["src/cli/<br/>options, config, output"]
    web["src/web/<br/>(future)"]
    core["src/core/<br/>use cases, ports, errors,<br/>licence policy<br/><br/>imports: nothing outside core"]
    adapters["src/adapters/<br/>imslp, openscore, musescore,<br/>storage, postgres"]
    libs["Infrastructure libraries<br/>pg, fetch, fs, child_process"]

    scripts --> cli
    scripts --> core
    scripts --> adapters
    cli --> core
    web --> core
    adapters -- "implement ports,<br/>throw core errors" --> core
    adapters --> libs
    core -. "forbidden" .-> adapters
    core -. "forbidden" .-> libs

    linkStyle 7 stroke:#c0392b,stroke-width:2px,color:#c0392b
    linkStyle 8 stroke:#c0392b,stroke-width:2px,color:#c0392b

    classDef driving fill:#e8f0fe,stroke:#3b6fd8,color:#1f2933
    classDef core fill:#ffffff,stroke:#3b6fd8,stroke-width:3px,color:#1f2933
    classDef adapter fill:#e7f6ec,stroke:#2f8a4c,color:#1f2933
    classDef ext fill:#f1f3f5,stroke:#7b8494,color:#1f2933
    classDef future fill:#ffffff,stroke:#7b8494,stroke-dasharray:6 4,color:#5b6577

    class scripts,cli driving
    class core core
    class adapters adapter
    class libs ext
    class web future
