%%{init: {"theme": "base", "htmlLabels": false, "flowchart": {"htmlLabels": false, "curve": "basis", "nodeSpacing": 40, "rankSpacing": 70}, "themeVariables": {"fontFamily": "Arial", "fontSize": "15px", "lineColor": "#5b6577", "primaryTextColor": "#1f2933"}}}%%
%% FINAL v2: where things run.
%% Solid borders = today (T1-T8, on the owner's laptop, plus internet services).
%% Dashed borders = a future public website that reuses the same core with read-only credentials.
%% Backblaze B2 is shared by both: the laptop uploads, the website only hands out short-lived links.

flowchart TB
    lap["Owner's laptop: CLI scripts<br/>Node 24 via mise"]
    browser["User's browser<br/>(future)"]

    pg[("PostgreSQL 17<br/>Docker, on the laptop")]
    ms[("MuseScore 4<br/>on the laptop")]
    clone[("OpenScore Lieder<br/>git clone, on the laptop")]
    imslp[("IMSLP API<br/>internet, metadata only")]
    websrv["Web server: src/web, same core<br/>rights-cleared files only (future)"]

    b2[("Backblaze B2: private bucket<br/>EU Central, SSE-B2")]
    pgweb[("PostgreSQL<br/>read-only role (future)")]

    lap --> pg
    lap --> ms
    lap --> clone
    lap -- "HTTPS, 2 s delay" --> imslp
    lap -- "upload key:<br/>one bucket, read + write" --> b2

    browser -- "search, preview" --> websrv
    websrv -- "read-only key:<br/>short-lived links" --> b2
    websrv --> pgweb
    browser -. "download via link" .-> b2

    classDef run fill:#e8f0fe,stroke:#3b6fd8,stroke-width:2px,color:#1f2933
    classDef data fill:#e7f6ec,stroke:#2f8a4c,color:#1f2933
    classDef ext fill:#f1f3f5,stroke:#7b8494,stroke-width:2px,color:#1f2933
    classDef future fill:#ffffff,stroke:#7b8494,stroke-dasharray:6 4,color:#5b6577

    class lap run
    class pg,ms,clone data
    class imslp,b2 ext
    class browser,websrv,pgweb future
