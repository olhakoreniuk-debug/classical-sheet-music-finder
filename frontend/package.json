{
  "name": "classical-sheet-music-finder-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "React + TypeScript frontend for the Classical Sheet Music Finder, built from openapi.yaml.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode mock",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../openapi.yaml --output src/api/generated/schema.ts",
    "api:types:check": "node scripts/check-api-types.mjs",
    "check": "npm run api:types:check && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
