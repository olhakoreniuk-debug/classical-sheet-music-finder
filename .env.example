# Copy this file to .env and set your own values.
# .env is ignored by git. Never commit real credentials.

# PostgreSQL (Docker)
POSTGRES_USER=sheetmusic
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sheetmusic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# IMSLP importer
IMSLP_BASE_URL=https://imslp.org/imslpscripts/API.ISCR.php
IMPORT_PAGE_SIZE=1000
IMPORT_DELAY_MS=2000
IMPORT_TIMEOUT_MS=30000
IMPORT_RETRIES=3

# REST API (npm run api). Local development only (ADR-0003).
API_HOST=127.0.0.1
API_PORT=3000
# POST /works is refused (403) unless this is true.
API_WRITES_ENABLED=false
# Extra origins allowed to write, comma-separated (the Vite dev server).
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
